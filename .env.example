# Copy this file, name the copy .env, and fill in your details.
# The .env file is listed in .gitignore, so it is never uploaded to GitHub.

SNOWFLAKE_ACCOUNT=ORGNAME-ACCOUNTNAME
SNOWFLAKE_USER=YOUR_USER_NAME
SNOWFLAKE_WAREHOUSE=CREDIT_RISK_WH
SNOWFLAKE_ROLE=ACCOUNTADMIN

# Paste your programmatic access token here. Create it with sql/setup_access_token.sql.
# Browser sign in (leaving this empty) works only if your account uses single sign on.
SNOWFLAKE_PASSWORD=
